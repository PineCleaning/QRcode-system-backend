// Pine Cleaning QR Feedback System — Prisma schema (v1.5)
// Source: pine-cleaning-schema-v1_5.sql, with two deviations (both
// user-confirmed 2026-07-24):
//   1. feedback_submissions' text field is named `feedback`, not `message`.
//   2. client_site_status is 2-state (ACTIVE/INACTIVE) — the source SQL's
//      third ARCHIVED state was dropped as unnecessary complexity.
//
// idempotency_key on feedback_submissions is frontend-generated (plain
// UUID v4 at form-mount) — the backend only enforces the unique
// constraint, it never derives or hashes the key itself.
//
// admin_users.id references Supabase Auth's auth.users(id). Prisma
// can't model that cross-schema FK directly — add it manually via a
// migration SQL edit after `prisma migrate dev --create-only`:
//   alter table admin_users
//     add constraint admin_users_id_fkey
//     foreign key (id) references auth.users(id) on delete cascade;

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AdminStatus {
  ACTIVE
  INACTIVE

  @@map("admin_status")
}

enum AdminRole {
  ADMIN
  SUPERVISOR
  MANAGER
  ADMIN_SUPPORT

  @@map("admin_role")
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  URGENT_LOW_STOCK
  OUT_OF_STOCK
  GOOD
  NEEDS_REPAIR
  OUT_OF_SERVICE

  @@map("inventory_status")
}

enum InventoryCategory {
  CHEMICAL
  PPE
  CONSUMABLES
  CLEANING_TOOLS_MANUAL
  POWERED_EQUIPMENT_MACHINERY
  SPARE_PARTS
  OTHER

  @@map("inventory_category")
}

enum InspectionSessionStatus {
  OPEN
  COMPLETED

  @@map("inspection_session_status")
}

enum InspectionRating {
  EXCELLENT
  ABOVE_AVERAGE
  AVERAGE
  BELOW_AVERAGE
  VERY_POOR

  @@map("inspection_rating")
}

enum ClickupConnectionStatus {
  CONNECTED
  DISCONNECTED
  RECONNECT_REQUIRED

  @@map("clickup_connection_status")
}

enum ClientSiteStatus {
  ACTIVE
  INACTIVE

  @@map("client_site_status")
}

enum FeedbackStatus {
  DRAFT
  SUBMITTED
  DELIVERY_PENDING
  DELIVERED
  DELIVERY_FAILED

  @@map("feedback_status")
}

enum MediaResourceType {
  IMAGE
  VIDEO

  @@map("media_resource_type")
}

enum MediaStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("media_status")
}

enum CsvBatchStatus {
  PROCESSING
  COMPLETED
  FAILED

  @@map("csv_batch_status")
}

enum CsvRowStatus {
  SUCCESS
  ERROR

  @@map("csv_row_status")
}

enum IntegrationJobStatus {
  PENDING
  PROCESSING
  RETRYING
  SUCCEEDED
  FAILED

  @@map("integration_job_status")
}

/// Profile table only — NOT auth. id references Supabase Auth's own
/// auth.users table; sign-in/passwords are fully owned by Supabase
/// Auth and never stored here.
///
/// Exactly one ADMIN row, ever, permanently - enforced via a
/// hand-written partial unique index (uq_admin_users_single_admin on
/// role where role = 'ADMIN'), not expressible in schema.prisma
/// directly, same reasoning as SiteInspection's uq_site_open_inspection.
/// The app layer also never allows creating or promoting a second
/// ADMIN (CreateAdminUserDto/UpdateAdminUserDto's role field excludes
/// 'ADMIN' entirely) - the DB constraint is the hard backstop.
model AdminUser {
  id        String      @id @db.Uuid
  email     String      @unique
  fullName  String?     @map("full_name")
  role      AdminRole   @default(ADMIN)
  status    AdminStatus @default(ACTIVE)
  createdAt DateTime    @default(now()) @map("created_at")
  lastLoginAt DateTime? @map("last_login_at")

  clientsCreated          Client[]            @relation("ClientCreatedBy")
  clickupConnections      ClickupConnection[]
  csvImportBatches        CsvImportBatch[]
  inventoryItemsCreated   InventoryItem[]     @relation("InventoryCreatedBy")
  inventoryItemsUpdated   InventoryItem[]     @relation("InventoryUpdatedBy")
  inventoryHistoryChanges InventoryHistory[]
  inspectionsCreated      SiteInspection[]    @relation("InspectionCreatedBy")
  inspectionsCompleted    SiteInspection[]    @relation("InspectionCompletedBy")
  inspectionItemsCreated  InspectionItem[]

  @@map("admin_users")
}

/// Site-level supply/asset record (discovery doc §1.3). `item` is plain
/// text (e.g. "Toilet Paper"), not an enum — the specific item's name,
/// not its category. `category` is the actual classification dropdown
/// ("Types" in the UI, confirmed with the user 2026-09-02).
model InventoryItem {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId         String            @map("site_id") @db.Uuid
  site           Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  item           String
  category       InventoryCategory
  status         InventoryStatus
  quantity       Int
  lastSupplyDate DateTime?         @map("last_supply_date")
  notes          String?
  createdBy      String?           @map("created_by") @db.Uuid
  createdByUser  AdminUser?        @relation("InventoryCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy      String?           @map("updated_by") @db.Uuid
  updatedByUser  AdminUser?        @relation("InventoryUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  history InventoryHistory[]

  @@index([siteId])
  @@map("inventory_items")
}

/// Snapshot of an InventoryItem's PRE-update values. Capped at the
/// 10 most recent rows per item — pruned in application code
/// (InventoryService), not a DB constraint. Confirmed with the user
/// 2026-08-29 ("Q3").
model InventoryHistory {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventoryItemId  String          @map("inventory_item_id") @db.Uuid
  inventoryItem    InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  previousQuantity Int             @map("previous_quantity")
  previousStatus   InventoryStatus @map("previous_status")
  previousNotes    String?         @map("previous_notes")
  changedBy        String?         @map("changed_by") @db.Uuid
  changedByUser    AdminUser?      @relation(fields: [changedBy], references: [id], onDelete: SetNull)
  changedAt        DateTime        @default(now()) @map("changed_at")

  @@index([inventoryItemId])
  @@map("inventory_history")
}

/// One inspection session per site. A session can span multiple
/// visits/days and stays OPEN until every space/item is covered
/// (rated or marked Not Applicable) and explicitly finished —
/// confirmed with the user 2026-08-29 ("Q1"/"Q2"). Only one OPEN
/// session per site at a time — enforced via a hand-written partial
/// unique index (uq_site_open_inspection), not expressible in
/// schema.prisma directly.
model SiteInspection {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId          String                  @map("site_id") @db.Uuid
  site            Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  status          InspectionSessionStatus @default(OPEN)
  averageScore    Int?                    @map("average_score")
  meetsStandard   Boolean?                @map("meets_standard")
  createdBy       String?                 @map("created_by") @db.Uuid
  createdByUser   AdminUser?              @relation("InspectionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  completedBy     String?                 @map("completed_by") @db.Uuid
  completedByUser AdminUser?              @relation("InspectionCompletedBy", fields: [completedBy], references: [id], onDelete: SetNull)
  startedAt       DateTime                @default(now()) @map("started_at")
  completedAt     DateTime?               @map("completed_at")

  items InspectionItem[]

  @@index([siteId])
  @@index([status])
  @@map("site_inspections")
}

/// One row per space/area/item inspected within a session. rating
/// and percentage are null when isNotApplicable is true — Not
/// Applicable items are excluded from the average score entirely
/// (confirmed with the user 2026-08-29, "Q1"/"Q2").
model InspectionItem {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspectionId    String            @map("inspection_id") @db.Uuid
  inspection      SiteInspection    @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  spaceName       String            @map("space_name")
  isNotApplicable Boolean           @default(false) @map("is_not_applicable")
  rating          InspectionRating?
  percentage      Int?
  notes           String?
  createdBy       String?           @map("created_by") @db.Uuid
  createdByUser   AdminUser?        @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  media InspectionMedia[]

  @@index([inspectionId])
  @@map("inspection_items")
}

/// Attachments for an inspection item. No stored URL — derive it
/// from cloudinaryPublicId + resourceType at read time, same
/// pattern as FeedbackMedia. Reuses the existing MediaResourceType/
/// MediaStatus enums.
model InspectionMedia {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspectionItemId   String            @map("inspection_item_id") @db.Uuid
  inspectionItem     InspectionItem    @relation(fields: [inspectionItemId], references: [id], onDelete: Cascade)
  cloudinaryPublicId String            @unique @map("cloudinary_public_id")
  resourceType       MediaResourceType @map("resource_type")
  originalFilename   String?           @map("original_filename")
  mimeType           String            @map("mime_type")
  sizeBytes          Int               @map("size_bytes")
  status             MediaStatus       @default(PENDING)
  uploadedAt         DateTime          @default(now()) @map("uploaded_at")

  @@index([inspectionItemId])
  @@map("inspection_media")
}

/// One row per authorised ClickUp Workspace connection (OAuth).
///
/// ticketsListId/companiesListId/clientFieldId/siteFieldId are
/// one-time-per-workspace config (Open Decision #3, resolved
/// 2026-07-24): feedback becomes Tasks in one shared TICKETS list;
/// clients map to existing records in a COMPANIES list; tickets link
/// to their company via a ClickUp Relationship custom field that
/// already exists in the workspace (field name "CLIENT NAME") — its
/// field_id is fetched once via GET /list/{list_id}/field and stored
/// here, never created programmatically. siteFieldId stays unused/
/// null for now — no structured Sites list exists in ClickUp today;
/// site is represented as plain text on the ticket instead.
model ClickupConnection {
  id                       String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId              String                  @unique @map("workspace_id")
  workspaceName            String?                 @map("workspace_name")
  encryptedAccessToken     String                  @map("encrypted_access_token")
  status                   ClickupConnectionStatus @default(CONNECTED)
  ticketsListId            String?                 @map("tickets_list_id")
  companiesListId          String?                 @map("companies_list_id")
  clientFieldId            String?                 @map("client_field_id")
  siteFieldId              String?                 @map("site_field_id")
  /// Cached once via POST /clickup/setup - the plain-text field a ticket's
  /// full feedback text + mobile number + attachment links get written to.
  requestDetailsFieldId    String?                 @map("request_details_field_id")
  /// Cached once via POST /clickup/setup - the dropdown field every
  /// ticket's Request Type gets set on.
  requestTypeFieldId       String?                 @map("request_type_field_id")
  /// The specific dropdown option id for "Other" - every ticket uses this
  /// one option (client confirmed no "Feedback" option exists and none
  /// will be created, per "only insert feedback as tickets").
  requestTypeOtherOptionId String?                 @map("request_type_other_option_id")
  /// Cached once via POST /clickup/setup - the "CLIENT ID" field that
  /// already exists on the COMPANIES list. Matching a ticket's client to
  /// its Company by this value (our unique client_id) instead of by name
  /// avoids ambiguity when two records share the same name.
  companyClientIdFieldId   String?                 @map("company_client_id_field_id")
  /// Set when an auth-class ClickUp failure (401 / ECODE OAUTH_025 "Token
  /// invalid") flips status to RECONNECT_REQUIRED - shown to the admin in
  /// the reconnect guide. Cleared back to null on a successful reconnect.
  lastErrorMessage         String?                 @map("last_error_message")
  /// When this connection was flipped to RECONNECT_REQUIRED. Cleared back
  /// to null on a successful reconnect.
  disconnectedAt           DateTime?               @map("disconnected_at")
  connectedBy              String?                 @map("connected_by") @db.Uuid
  connectedByUser          AdminUser?              @relation(fields: [connectedBy], references: [id], onDelete: SetNull)
  connectedAt              DateTime                @default(now()) @map("connected_at")

  @@index([status])
  @@map("clickup_connections")
}

/// One row per client company of the cleaning business.
model Client {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String           @unique @map("client_id")
  clientName      String           @map("client_name")
  status          ClientSiteStatus @default(ACTIVE)
  clickupEntityId String?          @map("clickup_entity_id")
  createdBy       String?          @map("created_by") @db.Uuid
  createdByUser   AdminUser?       @relation("ClientCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  sites         Site[]
  csvImportRows CsvImportRow[]

  @@index([status])
  @@index([clientName])
  @@map("clients")
}

/// One row per physical location. Owns the permanent QR slug. Every
/// client should have at least one site (enforced at the application
/// layer, not as a DB constraint).
model Site {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientCode      String           @map("client_code") @db.Uuid
  client          Client           @relation(fields: [clientCode], references: [id], onDelete: Cascade)
  siteCode        String           @map("site_code")
  slug            String           @unique
  businessName    String           @map("business_name")
  address         String?
  status          ClientSiteStatus @default(ACTIVE)
  clickupEntityId String?          @map("clickup_entity_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  feedbackSubmissions FeedbackSubmission[]
  csvImportRows       CsvImportRow[]
  inventoryItems      InventoryItem[]
  inspections         SiteInspection[]

  @@unique([clientCode, siteCode], map: "uq_client_site_code")
  @@index([status])
  @@index([slug])
  @@map("sites")
}

/// One row per customer feedback scan+submit. idempotencyKey
/// guarantees a submission can never accidentally create more than
/// one ClickUp task.
model FeedbackSubmission {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId         String         @map("site_id") @db.Uuid
  site           Site           @relation(fields: [siteId], references: [id], onDelete: Restrict)
  idempotencyKey String         @unique @map("idempotency_key")
  /// Named `feedback`, not `message` — user override of the v1.5 SQL source (2026-07-24).
  feedback       String
  mobileNumber   String?        @map("mobile_number")
  status         FeedbackStatus @default(SUBMITTED)
  clickupTaskId  String?        @map("clickup_task_id")
  submittedAt    DateTime       @default(now()) @map("submitted_at")
  deliveredAt    DateTime?      @map("delivered_at")

  media           FeedbackMedia[]
  integrationJobs IntegrationJob[]

  @@index([siteId])
  @@index([submittedAt])
  @@index([status])
  @@map("feedback_submissions")
}

/// Photos/videos attached to a feedback submission. No stored URL —
/// derive it from cloudinaryPublicId + resourceType at read time.
model FeedbackMedia {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedbackId         String             @map("feedback_id") @db.Uuid
  feedback           FeedbackSubmission @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  cloudinaryPublicId String             @unique @map("cloudinary_public_id")
  resourceType       MediaResourceType  @map("resource_type")
  originalFilename   String?            @map("original_filename")
  mimeType           String             @map("mime_type")
  sizeBytes          Int                @map("size_bytes")
  status             MediaStatus        @default(PENDING)
  createdAt          DateTime           @default(now()) @map("created_at")

  @@index([feedbackId])
  @@map("feedback_media")
}

/// One row per bulk CSV upload event.
model CsvImportBatch {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploadedBy     String?        @map("uploaded_by") @db.Uuid
  uploadedByUser AdminUser?     @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)
  filename       String
  status         CsvBatchStatus @default(PROCESSING)
  totalRows      Int            @default(0) @map("total_rows")
  successCount   Int            @default(0) @map("success_count")
  errorCount     Int            @default(0) @map("error_count")
  createdAt      DateTime       @default(now()) @map("created_at")

  rows CsvImportRow[]

  @@index([createdAt])
  @@index([status])
  @@map("csv_import_batches")
}

/// One row per line in a CSV upload, with per-row result. client_code
/// and site_id are nullable: a failed row never created one.
model CsvImportRow {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId      String         @map("batch_id") @db.Uuid
  batch        CsvImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber    Int            @map("row_number")
  clientCode   String?        @map("client_code") @db.Uuid
  client       Client?        @relation(fields: [clientCode], references: [id], onDelete: SetNull)
  siteId       String?        @map("site_id") @db.Uuid
  site         Site?          @relation(fields: [siteId], references: [id], onDelete: SetNull)
  status       CsvRowStatus
  errorMessage String?        @map("error_message")
  createdAt    DateTime       @default(now()) @map("created_at")

  @@unique([batchId, rowNumber], map: "uq_batch_row_number")
  @@index([batchId])
  @@map("csv_import_rows")
}

/// The ClickUp delivery/retry engine for a feedback submission.
model IntegrationJob {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feedbackId    String               @map("feedback_id") @db.Uuid
  feedback      FeedbackSubmission   @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  jobType       String               @default("clickup_task_creation") @map("job_type")
  status        IntegrationJobStatus @default(PENDING)
  attemptCount  Int                  @default(0) @map("attempt_count")
  nextAttemptAt DateTime?            @map("next_attempt_at")
  externalId    String?              @map("external_id")
  lastError     String?              @map("last_error")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@unique([feedbackId, jobType], map: "uq_feedback_job_type")
  @@index([status])
  @@index([nextAttemptAt])
  @@map("integration_jobs")
}
