DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
# Personal API token from ClickUp: Settings > Apps > ClickUp API > Generate.
# Setting this connects ClickUp automatically on the next backend restart -
# no OAuth flow needed. CLICKUP_CLIENT_ID/SECRET/REDIRECT_URI below are for
# the (currently unused) OAuth path - only needed if this ever moves to a
# registered OAuth app instead of a personal token.
CLICKUP_API_TOKEN=
# Optional - only needed if CLICKUP_API_TOKEN has access to more than one
# workspace (e.g. the admin's personal workspace plus the business one).
# Pins which one to connect to. Leave blank if the token only has access
# to a single workspace.
CLICKUP_WORKSPACE_ID=
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
CLICKUP_REDIRECT_URI=http://localhost:3000/clickup/oauth/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLICKUP_TOKEN_ENCRYPTION_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BASE_DOMAIN=
