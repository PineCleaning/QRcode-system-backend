DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
# Personal API token from ClickUp: Settings > Apps > ClickUp API > Generate.
# Setting this connects ClickUp automatically on the next backend restart -
# no OAuth flow needed. CLICKUP_CLIENT_ID/SECRET/REDIRECT_URI below are for
# the (currently unused) OAuth path - only needed if this ever moves to a
# registered OAuth app instead of a personal token.
CLICKUP_API_TOKEN=
# Optional - only needed if CLICKUP_API_TOKEN has access to more than one
# workspace (e.g. the admin's personal workspace plus the business one).
# Pins which one to connect to. Leave blank if the token only has access
# to a single workspace.
CLICKUP_WORKSPACE_ID=
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
CLICKUP_REDIRECT_URI=http://localhost:3000/clickup/oauth/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLICKUP_TOKEN_ENCRYPTION_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BASE_DOMAIN=
# Optional - all four required together to auto-sync a freshly reconnected
# ClickUp token (POST /clickup/reconnect-token) into Railway's own
# CLICKUP_API_TOKEN variable, so the client never needs Railway access to
# fix a broken ClickUp connection. Leave blank to skip - the reconnect
# still works without these, it just won't also update Railway.
#
# RAILWAY_API_TOKEN: a Workspace Token (not an Account Token - too broad -
# and not a Project Token - unclear if it supports variable mutations).
# Generate at railway.com/account/tokens, picking the specific workspace
# this project lives in (not "No workspace").
# RAILWAY_PROJECT_ID / RAILWAY_ENVIRONMENT_ID: from the project URL,
# railway.com/project/<projectId>/environment/<environmentId>.
# RAILWAY_SERVICE_ID: from the backend service's own settings page in the
# Railway dashboard, or `railway status` via the CLI.
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=
